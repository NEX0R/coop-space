{
 "namespace": "server_form",
 "long_form": {
  "type": "panel",
  "controls": [
   {
    "long_form@common_dialogs.main_panel_no_buttons": {
     "$title_panel": "common_dialogs.standard_title_label",
     "$title_size": [
      "100% - 15px",
      10
     ],
     "$title_max_size": [
      "100% - 15px",
      10
     ],
     "size": [
      225,
      200
     ],
     "$text_name": "#title_text",
     "$title_text_binding_type": "none",
     "$child_control": "server_form.long_form_panel",
     "layer": 2,
     "bindings": [
      {
       "binding_name": "#title_text"
      },
      {
       "binding_type": "view",
       "source_property_name": "(not (#title_text = 'vamp:barra'))",
       "target_property_name": "#visible"
      }
     ]
    }
   },
   {
    "vamp_ruota@server_form.vamp_ruota": {
     "bindings": [
      {
       "binding_name": "#title_text"
      },
      {
       "binding_type": "view",
       "source_property_name": "(#title_text = 'vamp:barra')",
       "target_property_name": "#visible"
      }
     ]
    }
   }
  ]
 },
 "vamp_ruota": {
  "type": "panel",
  "layer": 2,
  "controls": [
   {
    "sfondo": {
     "type": "image",
     "texture": "textures/ui/vamp/pannello",
     "size": [
      404,
      40
     ],
     "anchor_from": "center",
     "anchor_to": "center"
    }
   },
   {
    "fila": {
     "type": "stack_panel",
     "orientation": "horizontal",
     "size": [
      "100%c",
      28
     ],
     "anchor_from": "center",
     "anchor_to": "center",
     "factory": {
      "name": "buttons",
      "control_ids": {
       "button": "server_form.vamp_tasto",
       "label": "@server_form.dynamic_label",
       "header": "@server_form.dynamic_header",
       "divider": "@settings_common.option_group_section_divider"
      }
     },
     "collection_name": "form_buttons",
     "bindings": [
      {
       "binding_name": "#form_button_contents",
       "binding_name_override": "#collection_length"
      }
     ]
    }
   },
   {
    "nome": {
     "type": "label",
     "anchor_from": "center",
     "anchor_to": "center",
     "offset": [
      0,
      30
     ],
     "color": [
      1,
      0.85,
      0.85
     ],
     "shadow": true,
     "text": "#form_text",
     "bindings": [
      {
       "binding_name": "#form_text"
      }
     ]
    }
   }
  ]
 },
 "vamp_tasto": {
  "type": "panel",
  "size": [
   28,
   28
  ],
  "controls": [
   {
    "b@common.button": {
     "size": [
      26,
      26
     ],
     "$pressed_button_name": "button.form_button_click",
     "bindings": [
      {
       "binding_type": "collection_details",
       "binding_collection_name": "form_buttons"
      }
     ],
     "controls": [
      {
       "default@server_form.vamp_icona": {
        "$sfondo": "textures/ui/vamp/slot"
       }
      },
      {
       "hover@server_form.vamp_icona": {
        "$sfondo": "textures/ui/vamp/slot_sel"
       }
      },
      {
       "pressed@server_form.vamp_icona": {
        "$sfondo": "textures/ui/vamp/slot_sel"
       }
      }
     ]
    }
   }
  ]
 },
 "vamp_icona": {
  "type": "image",
  "texture": "$sfondo",
  "size": [
   "100%",
   "100%"
  ],
  "controls": [
   {
    "icona": {
     "type": "image",
     "size": [
      "100% - 6px",
      "100% - 6px"
     ],
     "layer": 1,
     "bindings": [
      {
       "binding_name": "#form_button_texture",
       "binding_name_override": "#texture",
       "binding_type": "collection",
       "binding_collection_name": "form_buttons"
      },
      {
       "binding_name": "#form_button_texture_file_system",
       "binding_name_override": "#texture_file_system",
       "binding_type": "collection",
       "binding_collection_name": "form_buttons"
      }
     ]
    }
   }
  ]
 }
}